use world;
select * from countrylanguage;
select * from country;
select * from city;
select name,Continent from country where Continent in('Africa','Asia','Europe');
select name from country where name like 'A%';
select name,population from city where population between 1000 and 2000;
select name,Continent from country where name like ('%land%') and Continent in ('Europe','Oceaina');
select name ,population from country where population =(select max(population) from country);
select name, population from city where population >(select avg(population) from city);
select name,population from country where population >(select population from country where name='Brazil');
select Continent from country where name population = (select count(continent) from country);
select Continent from country group by continent having count(name)=(select max(country_count)from(select continent , count(name) as country_count from country group by continent) as subquery);
select name from country where (select population from city  where city.name =country.capital)>(0.1* country.population);
select name  from country where population =(select min(population) from country where capital in (select name from city where popultion >500000));
select name ,(population/surfaceArea)as density from country where (population/surfaceArea)>(select avg(population/surfaceArea)from country);
select name ,population from city as c1 where population >(select avg(population) from city as c2 where c1.countrycode=c2.countrycode);
select name,population from country as c1 where population >(select avg(population) from country as c2 where c1.continent=c2.continent);
select name,LifeExpectancy from country as a1 where LifeExpectancy >(select avg(LifeExpectancy) from country as a2 where a1.region=a2.region);
select name,population from city as c1 where population >(select max(population) from city as c2 where c1.countrycode=c2.countrycode and c1.name!=c2.name);
